{
  "name": "@dailykitchen/contracts",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Shared TypeScript contracts and API interfaces for DailyKitchen",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "generate": "npx openapi-typescript ../../docs/contracts/openapi.json -o ./src/generated/api-types.ts",
    "contracts:check": "tsc --noEmit"
  },
  "devDependencies": {
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.4.5"
  }
}
