# DailyKitchen Backend Environment Configuration
ENVIRONMENT=development
DEBUG=true
PORT=8000

# Required in production; in development a dedicated dev secret can be used
SECRET_KEY=change-this-in-production-to-a-secure-random-secret-key-at-least-32-chars

# Database: SQLite async for local development; PostgreSQL async for staging/production
DATABASE_URL=sqlite+aiosqlite:///./dailykitchen.db
# Production PostgreSQL example:
# DATABASE_URL=postgresql+asyncpg://dailykitchen_user:password@localhost:5432/dailykitchen_db

# Explicit CORS Origins (comma-separated or JSON list)
CORS_ORIGINS=["http://localhost:3000","http://localhost:8081","http://127.0.0.1:3000","http://127.0.0.1:8081"]

# Pricing Policy Rules (Authoritative Backend Defaults)
PACKAGING_FEE=10
STANDARD_DELIVERY_FEE=40
FREE_DELIVERY_THRESHOLD=99
